# CyberGuard environment variables — EXAMPLE / PLACEHOLDERS ONLY
# Copy to a local .env file (which is git-ignored) and fill in real values.
# NEVER commit a real .env or real tokens.

# --- Flask ---
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change-me-in-local-env

# --- Suricata EVE JSON integration ---
# EVE JSON output written by Suricata (Kali VM default shown).
CYBERGUARD_EVE_PATH=/var/log/suricata/eve.json
# Suricata pidfile + /proc base used to verify the process (Linux only).
CYBERGUARD_SURICATA_PID=/tmp/suricata.pid
CYBERGUARD_PROC_BASE=/proc
# SQLite database (git-ignored).
CYBERGUARD_DB_PATH=data/cyberguard.db
# Background ingestion poll interval (seconds).
CYBERGUARD_POLL_SECONDS=2

# --- Telegram notifications (OPTIONAL) ---
# Leave BOTH of these BLANK to disable Telegram (everything works as before).
# Fill them in only in your LOCAL, git-ignored .env. NEVER commit real values.
# See docs/phase7-telegram.md for how to get these from BotFather.
CYBERGUARD_TELEGRAM_TOKEN=
CYBERGUARD_TELEGRAM_CHAT_ID=
# Optional tuning (leave blank to use the defaults shown in the comments):
# Notify only when alert severity <= N (1 = critical). Default 3.
CYBERGUARD_TELEGRAM_MIN_SEVERITY=
# Max messages per rolling minute; excess collapsed into one summary. Default 5.
CYBERGUARD_TELEGRAM_RATE_PER_MIN=
