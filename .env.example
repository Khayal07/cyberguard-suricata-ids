# CyberGuard environment variables — EXAMPLE / PLACEHOLDERS ONLY
# Copy to a local .env file (which is git-ignored) and fill in real values.
# NEVER commit a real .env or real tokens.

# --- Flask ---
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change-me-in-local-env

# --- Suricata / data paths (set once the engine is configured) ---
EVE_JSON_PATH=/var/log/suricata/eve.json
SQLITE_DB_PATH=cyberguard.db

# --- Telegram notifications (optional, final phase) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
